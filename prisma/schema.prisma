generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Auth.js models, see https://authjs.dev/getting-started/adapters/prisma

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // Null for users who only sign in with Google.
  passwordHash  String?
  // Short code in the public order link, e.g. /order/MKH975. Set the first
  // time the link is needed.
  orderSlug     String?   @unique
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  capitalSources CapitalSource[]
  capitalEntries CapitalEntry[]
  products       Product[]
  suppliers      Supplier[]
  purchases      Purchase[]
  customers      Customer[]
  sales          Sale[]
  expenses       Expense[]
  saleReturns    SaleReturn[]
  cashJournal    CashJournalEntry[]
  healthTargets  HealthTargets?
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// Business ledger models

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CARD
  OTHER
}

enum CapitalSourceType {
  OWNER
  INVESTOR
  LOAN
}

enum CapitalEntryType {
  RECEIVED
  REPAID
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum SaleStatus {
  DRAFT
  PREORDER
  COMPLETED
  CANCELLED
}

// Where money comes from and what is repaid.
model CapitalSource {
  id        String            @id @default(cuid())
  userId    String
  name      String
  type      CapitalSourceType
  entries   CapitalEntry[]
  createdAt DateTime          @default(now())
  // Soft delete: hidden from lists and pickers; its entries stay.
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CapitalEntry {
  id       String           @id @default(cuid())
  userId   String
  sourceId String
  // RECEIVED adds cash and owed capital; REPAID removes both.
  type     CapitalEntryType
  amount   Decimal          @db.Decimal(14, 2)
  method   PaymentMethod    @default(CASH)
  date     DateTime         @default(now())
  note     String?

  source CapitalSource @relation(fields: [sourceId], references: [id])
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([sourceId])
}

model Product {
  id             String           @id @default(cuid())
  userId         String
  name           String
  // Each perfume size is a separate product. Brand is chosen per sale item.
  sizeMl         Int
  sku            String?
  // Usual price paid to suppliers; pre-fills the unit cost on purchases.
  buyingPrice    Decimal?         @db.Decimal(14, 2)
  // Default price, editable per sale.
  sellingPrice   Decimal          @db.Decimal(14, 2)
  quantityOnHand Int              @default(0)
  // Weighted average cost.
  avgCost        Decimal          @default(0) @db.Decimal(14, 4)
  active         Boolean          @default(true)
  // Soft delete: hidden from lists and pickers; past sales and purchases stay.
  deletedAt      DateTime?
  purchaseItems  PurchaseItem[]
  saleItems      SaleItem[]
  returnItems    SaleReturnItem[]
  movements      StockMovement[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name, sizeMl])
}

model Supplier {
  id        String     @id @default(cuid())
  userId    String
  name      String
  phone     String?
  purchases Purchase[]
  // Soft delete: hidden from lists and pickers; their purchases stay.
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Purchase {
  id         String         @id @default(cuid())
  userId     String
  supplierId String?
  // DRAFT means ordered, stock has not arrived yet.
  status     PurchaseStatus @default(DRAFT)
  date       DateTime       @default(now())
  receivedAt DateTime?
  method     PaymentMethod  @default(CASH)
  // Sum of items; paid in full on receipt.
  total      Decimal        @db.Decimal(14, 2)
  note       String?
  items      PurchaseItem[]

  supplier Supplier? @relation(fields: [supplierId], references: [id])
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model PurchaseItem {
  id         String  @id @default(cuid())
  purchaseId String
  productId  String
  quantity   Int
  unitCost   Decimal @db.Decimal(14, 4)
  lineTotal  Decimal @db.Decimal(14, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
}

model Customer {
  id        String    @id @default(cuid())
  userId    String
  name      String
  phone     String?
  email     String?
  sales     Sale[]
  createdAt DateTime  @default(now())
  // Soft delete: hidden from lists and pickers; their sales stay.
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Sale {
  id          String       @id @default(cuid())
  userId      String
  // Null means walk-in; a PREORDER needs a customer.
  customerId  String?
  status      SaleStatus   @default(DRAFT)
  // Day it was sold; for a delivered preorder, the delivery day.
  date        DateTime     @default(now())
  // Day a preorder was taken; null for ordinary sales.
  orderedAt   DateTime?
  completedAt DateTime?
  // Sum of items minus discount.
  total       Decimal      @db.Decimal(14, 2)
  discount    Decimal      @default(0) @db.Decimal(14, 2)
  note        String?
  items       SaleItem[]
  // Balance is total minus the sum of payments. Refunds are negative.
  payments    Payment[]
  returns     SaleReturn[]

  customer Customer? @relation(fields: [customerId], references: [id])
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, status])
  @@index([customerId])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String
  quantity  Int
  // Brand chosen for this sale; one product can be sold under many brands.
  brand     String?
  // Price actually charged.
  unitPrice Decimal @db.Decimal(14, 2)
  // Product avgCost at the moment the sale completes.
  unitCost  Decimal @db.Decimal(14, 4)
  lineTotal Decimal @db.Decimal(14, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

// Installments: many payments per sale.
model Payment {
  id     String        @id @default(cuid())
  saleId String
  amount Decimal       @db.Decimal(14, 2)
  method PaymentMethod
  paidAt DateTime      @default(now())
  note   String?

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

// Items brought back from a completed sale. The sale itself is reduced (its
// items and total) and any refund is a negative payment, so every figure
// derived from sales stays right; this keeps the history of what came back.
model SaleReturn {
  id        String           @id @default(cuid())
  userId    String
  saleId    String
  date      DateTime
  // What the returned items were worth on the sale, after its discount.
  credit    Decimal          @db.Decimal(14, 2)
  // Paid back to the customer; the rest of the credit cleared their debt.
  refund    Decimal          @db.Decimal(14, 2)
  method    PaymentMethod    @default(CASH)
  note      String?
  items     SaleReturnItem[]
  createdAt DateTime         @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([userId, date])
}

model SaleReturnItem {
  id        String  @id @default(cuid())
  returnId  String
  productId String
  quantity  Int
  brand     String?
  // As charged and as costed on the sale.
  unitPrice Decimal @db.Decimal(14, 2)
  unitCost  Decimal @db.Decimal(14, 4)

  saleReturn SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@index([returnId])
}

// Business expenses, kept apart from purchases and capital.
model Expense {
  id          String        @id @default(cuid())
  userId      String
  category    String
  amount      Decimal       @db.Decimal(14, 2)
  method      PaymentMethod @default(CASH)
  date        DateTime      @default(now())
  description String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// Audit trail for stock quantity.
model StockMovement {
  id        String            @id @default(cuid())
  productId String
  type      StockMovementType
  // Positive for stock in, negative for stock out.
  quantity  Int
  // Purchase, sale or adjustment id.
  refId     String?
  // Adjustments only: why stock changed, by reason key, and an optional note.
  reason    String?
  note      String?
  // Adjustments only: the product's average cost at that moment, which
  // values the stock written off or added back.
  unitCost  Decimal?          @db.Decimal(14, 4)
  createdAt DateTime          @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, createdAt])
}

enum CashJournalKind {
  CAPITAL_RECEIVED
  CAPITAL_REPAID
  PURCHASE
  EXPENSE
  SALE_PAYMENT
  REFUND
  REVERSAL
}

// As on the cash account: a debit is money in, a credit is money out.
enum CashDirection {
  DEBIT
  CREDIT
}

enum CashJournalRef {
  CAPITAL
  EXPENSE
  PURCHASE
  SALE
}

// Audit trail for cash: one row per movement, written in the same
// transaction as the change it records. Rows are never changed or deleted (a
// trigger refuses it); a correction adds a REVERSAL of the old row, then a new
// one. balanceAfter is cash right after the row in the order rows were
// recorded, so it shows what the books said at that moment.
model CashJournalEntry {
  id           String          @id @default(cuid())
  userId       String
  // 1, 2, 3... per user in recording order; a gap means a row is missing.
  seq          Int
  // The business date of the movement, which may be backdated.
  occurredAt   DateTime
  recordedAt   DateTime        @default(now())
  kind         CashJournalKind
  direction    CashDirection
  // Always positive; direction says which way it moved.
  amount       Decimal         @db.Decimal(14, 2)
  balanceAfter Decimal         @db.Decimal(14, 2)
  method       PaymentMethod?
  // The record behind the row, e.g. SALE-7K2Q9X, and the payment within a
  // sale. Plain ids, not relations: the record may since have been deleted.
  refType      CashJournalRef
  refId        String
  lineId       String?
  reference    String
  // Written at the time, so later renames don't change history.
  description  String
  reversesId   String?         @unique

  reverses   CashJournalEntry? @relation("Reversal", fields: [reversesId], references: [id])
  reversedBy CashJournalEntry? @relation("Reversal")
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, seq])
  @@index([userId, occurredAt])
  @@index([userId, refType, refId])
}

// The bar each business-health indicator is judged against. Null means the
// app's default target.
model HealthTargets {
  id              String   @id @default(cuid())
  userId          String   @unique
  marginPct       Int?
  collectionPct   Int?
  salesTrendPct   Int?
  stockMaxDays    Int?
  paybackPct      Int?
  overdueDays     Int?
  repeatPct       Int?
  preorderMaxDays Int?
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Attempt counts for rate-limited actions (sign-in, sign-up, password reset),
// shared by every server instance. Rows past resetAt are stale and pruned.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}
