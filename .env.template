# Copy this file to .env and fill in the values.
# .env is gitignored; never commit real secrets.
# Both Next.js and the Prisma CLI read .env.

# Public URL of the app (exposed to the browser via the NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_APP_URL=http://localhost:3090

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pastelito?schema=public"

# Secret used by Auth.js to sign session cookies. Generate one with:
#   npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Google sign-in (optional). Leave empty to hide the Google button.
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# with redirect URI http://localhost:3090/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Note: PORT is not read from .env files. The dev and start scripts
# pin it with `-p 3090`; override for a single run with `npm run dev -- -p <port>`.
