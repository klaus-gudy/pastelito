# Copy this file to .env.local and fill in the values.
# .env.local is gitignored; never commit real secrets.

# Public URL of the app (exposed to the browser via the NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_APP_URL=http://localhost:3090

# Note: PORT is not read from .env files. The dev and start scripts
# pin it with `-p 3090`; override for a single run with `npm run dev -- -p <port>`.
